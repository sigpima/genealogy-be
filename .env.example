# Cấu hình cho backend khi chạy NGOÀI Docker (`uv run uvicorn ...`, `alembic`, `scripts/*.py`)
# và cho docker-compose.yml trong thư mục này (compose tự đọc file `.env` cạnh nó).
# Copy thành .env; KHÔNG commit .env. Tên biến trùng với ../.env.example (bản deploy).
#
# Thứ tự ưu tiên: biến môi trường của tiến trình > file này > mặc định trong code.

# --- Database ---------------------------------------------------------------
# Mặc định trỏ vào Postgres dev của docker-compose.yml này:
#   docker compose up -d --wait db      # lắng nghe 127.0.0.1:${POSTGRES_PORT}
#   uv run alembic upgrade head
# Mật khẩu dùng ký tự nào cũng được (app tự mã hoá khi dựng URL); bọc trong nháy
# đơn nếu có $, #, dấu nháy hoặc khoảng trắng.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=genealogy
# Muốn trỏ vào Postgres khác (đã cài sẵn trên máy...) thì sửa các dòng trên.
# DATABASE_URL (một chuỗi đầy đủ) vẫn dùng được nhưng KHÔNG cần: để cả hai thì
# DATABASE_URL trong file này thắng POSTGRES_* trong file này, dễ nhầm.
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# --- API --------------------------------------------------------------------
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRE_MINUTES=60
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# Ảnh đại diện lưu trên đĩa. Trong Docker compose đặt cứng /app/uploads (volume).
UPLOAD_DIR=uploads

# SMTP chỉ dùng cho email quên mật khẩu. Để trống thì API vẫn trả 200 nhưng không
# gửi mail thật.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Giới hạn tần suất (GĐ11). TRUSTED_PROXY_HOPS: số reverse proxy tin cậy phía trước (0 = không tin X-Forwarded-For).
# RATE_LIMIT_ENABLED=true
# TRUSTED_PROXY_HOPS=0

# --- Chỉ cho docker-compose.yml trong thư mục này (tuỳ chọn) ----------------
# API_PORT=8000        # cổng API publish ra 127.0.0.1
# TEST_DB_PORT=55432   # Postgres chạy test (tmpfs)
