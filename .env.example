DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/genealogy
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRE_MINUTES=60
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
UPLOAD_DIR=uploads

# SMTP is used for the forgot-password email. Leave blank to disable sending
# (forgot-password will still respond 200, but the email send itself will fail).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
